---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Projects | George Wilson" description="Data engineering and analytics projects.">
  <section class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-8">Projects</h1>
    {projects.length === 0 ? (
      <p class="text-gray-500 dark:text-gray-400">No projects yet. Check back soon!</p>
    ) : (
      <div class="space-y-2">
        {projects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            slug={project.id}
            tags={project.data.tags}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
