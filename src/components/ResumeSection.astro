---
import resume from '../data/resume.json';
---

<section class="space-y-10">
  <!-- Summary -->
  <div>
    <h2 class="text-2xl font-bold mb-3">Summary</h2>
    <p class="text-gray-700 dark:text-gray-300">{resume.summary}</p>
  </div>

  <!-- Experience -->
  <div>
    <h2 class="text-2xl font-bold mb-4">Experience</h2>
    <div class="space-y-6">
      {resume.experience.map((job) => (
        <div>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
            <h3 class="text-lg font-semibold">{job.title}</h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">{job.start} &ndash; {job.end}</span>
          </div>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">{job.company} &middot; {job.location}</p>
          {job.bullets.length > 0 && (
            <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 space-y-1 text-sm">
              {job.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          )}
        </div>
      ))}
    </div>
  </div>

  <!-- Education -->
  <div>
    <h2 class="text-2xl font-bold mb-4">Education</h2>
    {resume.education.map((edu) => (
      <div>
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
          <h3 class="text-lg font-semibold">{edu.school}</h3>
          <span class="text-sm text-gray-500 dark:text-gray-400">{edu.start} &ndash; {edu.end}</span>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-sm">{edu.degree}</p>
      </div>
    ))}
  </div>

  <!-- Skills -->
  <div>
    <h2 class="text-2xl font-bold mb-3">Skills</h2>
    <div class="flex flex-wrap gap-2">
      {resume.skills.map((skill) => (
        <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800 rounded-full text-sm text-gray-700 dark:text-gray-300">
          {skill}
        </span>
      ))}
    </div>
  </div>

  <!-- Certifications -->
  <div>
    <h2 class="text-2xl font-bold mb-3">Certifications</h2>
    <ul class="list-disc list-inside text-gray-700 dark:text-gray-300 text-sm space-y-1">
      {resume.certifications.map((cert) => <li>{cert}</li>)}
    </ul>
  </div>
</section>
